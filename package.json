{
  "name": "@arkanis-corporation/dcsh",
  "version": "0.3.1",
  "description": "Interactive REPL for troubleshooting Discord bots as the bot itself - REST-only, audit-logged, safe by default.",
  "keywords": [
    "discord",
    "discord-bot",
    "discord-api",
    "rest",
    "repl",
    "cli",
    "mongosh",
    "bot-tooling"
  ],
  "homepage": "https://dcsh.arkanis.space/",
  "bugs": "https://github.com/ArkanisCorporation/dcsh/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArkanisCorporation/dcsh.git"
  },
  "license": "MIT",
  "author": "Arkanis Corporation OÜ and contributors",
  "type": "module",
  "bin": {
    "dcsh": "dist/bin/dcsh.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": "^22.13.0 || >=23.5.0"
  },
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "pnpm typecheck && eslint . && prettier --check .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate": "pnpm lint && pnpm test && pnpm build",
    "act": "bash scripts/run-act.sh",
    "dev": "tsx bin/dcsh.ts",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@discordjs/rest": "2.6.3",
    "@inquirer/prompts": "8.7.5",
    "discord-api-types": "0.38.57"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
